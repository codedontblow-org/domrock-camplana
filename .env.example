## Banco (usado pelo postgres, backend e lana)
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Senha do papel somente leitura da Lana (criado pelo Flyway do backend)
LANA_DB_PASSWORD=lana_leitura

## IA (lana)
AI_PROVIDER= # GEMINI | OPENROUTER
AI_MODEL= # gemini-3.5-flash-lite ou outro modelo do provedor
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Reserva em ordem se o principal falhar (cota 429, fora do ar). Provedor sem chave é ignorado.
# A cota do Gemini é por modelo, então outro modelo Gemini já serve de primeira reserva.
AI_FALLBACKS=GEMINI:gemini-3.1-flash-lite,OPENROUTER:qwen/qwen3.8-27b:free,GROQ:openai/gpt-oss-120b
# Segundos por modelo antes de passar ao próximo da cadeia
AI_TIMEOUT_S=30

## Portas no host (opcional; troque se já estiverem em uso na sua máquina)
# POSTGRES_HOST_PORT=5432
# BACKEND_HOST_PORT=8080
# LANA_HOST_PORT=8000
# FRONTEND_HOST_PORT=5173
